---
// A página sai pronta com o conteúdo de content/site.json; no navegador,
// src/scripts/site.js troca pela versão mais nova salva pelo painel /admin.
import site from '../../content/site.json';
import { paginaHTML } from '../lib/render.js';

const titulo = `${site.nome} · Roteiro, filme e foto`;
---
<!doctype html>
<html lang="pt-BR" style={`--acc:${site.cor}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo}</title>
  <meta name="description" content={site.intro} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={site.intro} />
  <meta name="theme-color" content="#0c0c0b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Caveat+Brush&family=Space+Mono:wght@400;700&display=swap" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="spray" x="-10%" y="-20%" width="120%" height="150%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="warp" />
      <feDisplacementMap in="SourceGraphic" in2="warp" scale="9" xChannelSelector="R" yChannelSelector="G" result="w" />
      <feGaussianBlur in="w" stdDeviation="2.4" result="soft" />
      <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="1" seed="9" result="grain" />
      <feComposite in="soft" in2="grain" operator="arithmetic" k1="0" k2="2.4" k3="1.1" k4="-1.3" result="mask" />
      <feMorphology in="w" operator="dilate" radius="5" result="fat" />
      <feComposite in="fat" in2="mask" operator="in" />
    </filter>
  </svg>

  <header class="top wrap mono">
    <a class="brand" href="#">Pedro Simm<span class="sub dim">Roteiro / Filme / Foto</span></a>
    <nav class="mid" aria-label="Principal">
      <a href="#projetos">Projetos</a><a href="#outros">Serviços</a><a href="#kit">Kit</a><a href="#contato">Contato</a>
    </nav>
  </header>

  <main set:html={paginaHTML(site)} />

  <script id="conteudo-inicial" type="application/json" set:html={JSON.stringify(site)} />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
